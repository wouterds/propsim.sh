# Copy to .env beside this file. .env is gitignored, this one is not.
#
# Only the drizzle-kit scripts read these. Nothing in src/ loads a .env of its
# own: an app that imports this package brings its own environment, and the
# connection reads whatever that app already put in process.env.
#
# `db:generate` never connects to anything, it only diffs the schema against the
# migrations folder. It still needs the file to exist, because the config asks
# for every variable up front rather than letting mysql2 quietly default to
# localhost and an undefined database.
DB_HOST=localhost
DB_USER=propsim
DB_PASS=propsim
DB_NAME=propsim

# Optional, defaults to 50 in src/connection.ts.
DB_POOL_SIZE=
